{
  "info": {
    "name": "Scheduler App - Auth (minimal)",
    "description": "API-only collection for /api/v1/auth endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "jwtToken", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth API",
      "description": "Core JSON endpoints (signup, login, signout, me, verify, onboard)",
      "item": [
        {
          "name": "Signup - Patient",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"phone\": \"+1234567890\",\n  \"password\": \"password123\",\n  \"role\": \"patient\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/signup", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","signup"] }
          }
        },
        {
          "name": "Signup - Doctor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Dr. Jane Smith\",\n  \"email\": \"drjane@example.com\",\n  \"phone\": \"+1987654321\",\n  \"password\": \"doctor123\",\n  \"role\": \"doctor\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/signup", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","signup"] }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {"mode":"raw","raw":"{\"email\":\"john@example.com\",\"password\":\"password123\"}"},
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] }
          }
        },
        {
          "name": "Login - Invalid",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {"mode":"raw","raw":"{\"email\":\"wrong@example.com\",\"password\":\"wrong\"}"},
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] }
          }
        },
        {
          "name": "Signout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/signout", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","signout"] }
          }
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","me"] }
          }
        },
        {
          "name": "Request verification",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {"mode":"raw","raw":"{\"type\":\"email\"}"},
            "url": { "raw": "{{baseUrl}}/api/v1/auth/request-verification", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","request-verification"] }
          }
        },
        {
          "name": "Verify token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {"mode":"raw","raw":"{\"token\":\"123456\",\"type\":\"email\"}"},
            "url": { "raw": "{{baseUrl}}/api/v1/auth/verify", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","verify"] }
          }
        },
        {
          "name": "Onboard",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {"mode":"raw","raw":"{\"age\":30,\"gender\":\"other\"}"},
            "url": { "raw": "{{baseUrl}}/api/v1/auth/onboard", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","onboard"] }
          }
        },
        {
          "name": "List doctors",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/appointments/doctors", "host": ["{{baseUrl}}"], "path": ["api","v1","appointments","doctors"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const json = pm.response.json();",
                "if (Array.isArray(json) && json.length) {",
                "  pm.collectionVariables.set('doctorId', json[0].id);",
                "  if (json[0].slots && json[0].slots.length) {",
                "    pm.collectionVariables.set('slotId', json[0].slots[0].id);",
                "  }",
                "}",
                "pm.test('doctor list OK', () => { pm.expect(pm.response.code).to.equal(200); });"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Book appointment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {"mode":"raw","raw":"{\"doctorId\":\"{{doctorId}}\",\"slotId\":\"{{slotId}}\",\"consultingType\":\"regular\",\"visitType\":\"first_time\",\"complaint\":\"fever\"}"},
            "url": { "raw": "{{baseUrl}}/api/v1/appointments", "host": ["{{baseUrl}}"], "path": ["api","v1","appointments"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('book returned 200', () => { pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
                "const json = pm.response.json();",
                "if(json && json.id) pm.collectionVariables.set('appointmentId', json.id);"
              ],
              "type": "text/javascript"
            }
          }]
        },
        {
          "name": "Cancel appointment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/appointments/{{appointmentId}}/cancel", "host": ["{{baseUrl}}"], "path": ["api","v1","appointments","{{appointmentId}}","cancel"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('cancel returned 200', () => { pm.expect(pm.response.code).to.equal(200); });",
                "// optionally check status field if the API returns appointment object",
                "// const json = pm.response.json(); pm.expect(json.status).to.equal('cancelled');"
              ],
              "type": "text/javascript"
            }
          }]
        },

        {
          "name": "My appointments",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/appointments", "host": ["{{baseUrl}}"], "path": ["api","v1","appointments"] }
          }
        },
        {
          "name": "Doctor: get profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/doctor/profile", "host": ["{{baseUrl}}"], "path": ["api","v1","doctor","profile"] }
          }
        },
        {
          "name": "Doctor: update profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {"mode":"raw","raw":"{\"bio\":\"Experienced specialist\",\"specializations\":[\"Cardiology\"]}"},
            "url": { "raw": "{{baseUrl}}/api/v1/doctor/profile", "host": ["{{baseUrl}}"], "path": ["api","v1","doctor","profile"] }
          }
        },
        {
          "name": "Doctor: create slot",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {"mode":"raw","raw":"{\"date\":\"2026-03-01\",\"dayOfWeek\":\"Monday\",\"session\":\"morning\",\"startTime\":\"09:00\",\"endTime\":\"12:00\"}"},
            "url": { "raw": "{{baseUrl}}/api/v1/doctor/slots", "host": ["{{baseUrl}}"], "path": ["api","v1","doctor","slots"] }
          }
        },
        {
          "name": "Doctor: list slots",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/doctor/slots", "host": ["{{baseUrl}}"], "path": ["api","v1","doctor","slots"] }
          }
        },
        {
          "name": "Doctor: list appointments",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/doctor/appointments", "host": ["{{baseUrl}}"], "path": ["api","v1","doctor","appointments"] }
          }
        },
        {
          "name": "Doctor: cancel appointment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/doctor/appointments/{{appointmentId}}/cancel", "host": ["{{baseUrl}}"], "path": ["api","v1","doctor","appointments","{{appointmentId}}","cancel"] }
          }
        },

        {
          "name": "Google OAuth -- patient",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/google", "host": ["{{baseUrl}}"], "path": ["auth","google"], "query": [{"key":"state","value":"patient"}] }
          },
          "description": "Initiate Google login as patient. Follow redirect in browser."
        },
        {
          "name": "Google OAuth -- doctor",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/google?state=doctor", "host": ["{{baseUrl}}"], "path": ["auth","google"], "query": [{"key":"state","value":"doctor"}] }
          },
          "description": "Initiate Google login as doctor. Follow redirect in browser."
        }
      ]
    }
  ]
}
